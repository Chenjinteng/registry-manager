{
  "name": "registry-manager",
  "private": true,
  "version": "0.8.1",
  "description": "独立的 CNCF Distribution 镜像仓库管理 Web",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "license": "MIT",
  "author": "Chenjinteng",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chenjinteng/registry-manager.git"
  },
  "homepage": "https://github.com/Chenjinteng/registry-manager#readme",
  "bugs": {
    "url": "https://github.com/Chenjinteng/registry-manager/issues"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"node --disable-warning=ExperimentalWarning --watch server/index.mjs\" \"vite\"",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.mjs",
    "type-check": "tsc --noEmit",
    "verify": "node scripts/verify-auth.mjs && node scripts/verify-token-auth.mjs && node scripts/verify-upload-location.mjs && node --experimental-strip-types --no-warnings scripts/verify-job-expansion.mjs && node --experimental-strip-types --no-warnings scripts/verify-heatmap.mjs && node scripts/verify-pull.mjs && node --disable-warning=ExperimentalWarning scripts/verify-stats.mjs && node --disable-warning=ExperimentalWarning scripts/verify-pull-history.mjs && node scripts/verify-theme.mjs",
    "verify:auth": "node scripts/verify-auth.mjs",
    "verify:token": "node scripts/verify-token-auth.mjs",
    "verify:location": "node scripts/verify-upload-location.mjs",
    "verify:ui": "node --experimental-strip-types --no-warnings scripts/verify-job-expansion.mjs",
    "verify:heatmap": "node --experimental-strip-types --no-warnings scripts/verify-heatmap.mjs",
    "verify:layout": "node scripts/verify-layout.mjs",
    "verify:pull": "node scripts/verify-pull.mjs",
    "verify:stats": "node --disable-warning=ExperimentalWarning scripts/verify-stats.mjs",
    "verify:pull-history": "node --disable-warning=ExperimentalWarning scripts/verify-pull-history.mjs",
    "verify:theme": "node scripts/verify-theme.mjs",
    "verify:real": "node scripts/verify-real-registries.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "undici": "^7.2.0"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.6.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "antd": "^5.29.3",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
