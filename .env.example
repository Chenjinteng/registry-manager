# Docker Compose 的变量文件。
#   cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交。

# ── 必填 ────────────────────────────────────────────────────────────────────
# 要管理的 registry 地址（必须带 http:// 或 https://）
REGISTRY_URL=http://192.0.2.10:10001

# ── 可选 ────────────────────────────────────────────────────────────────────
# 访问 registry 需要经过的 HTTP 代理；留空表示直连。
# 注意这与「构建机访问 npm 的代理」不是一回事，那个走 --build-arg。
REGISTRY_PROXY=

# 本 registry 自身的 basic auth（可选）。
# 这是**部署级**凭据：没有它连「镜像列表」都打不开，所以必须在这里配，
# 而不是在页面的凭据管理里 —— 凭据管理只管**外部源**。
# 只暴露布尔给前端，密码不会出现在任何接口响应里。
REGISTRY_USERNAME=
REGISTRY_PASSWORD=

# 展示名称
REGISTRY_NAME=内网离线镜像源

# 清单缓存时长（秒）
REGISTRY_CACHE_TTL_SECONDS=60

# 设为 false 进入只读模式：隐藏删除入口并拒绝所有删除请求
REGISTRY_ALLOW_DELETE=true

# 设为 false 后服务端拒绝所有 /api/pull/* 写入（GET 列表仍可读历史任务）。
# 单并发 + FIFO 队列；任务仅存内存，重启即丢。
REGISTRY_ALLOW_PULL=true

# 内存里保留的最近任务数（当前 + 排队 + 已完成）；超出后按创建时间最旧剔除
REGISTRY_PULL_QUEUE_SIZE=50

# 凭据库密钥（必填；任意随机 32+ 字符字符串）。
# 用于 AES-256-GCM 加密 /app/data/credentials.json。
# **同时丢失密钥和文件 = 凭据永久不可恢复** —— 备份时务必一起带走。
# 用 openssl rand -hex 32 生成：
#   openssl rand -hex 32
REGISTRY_CREDENTIAL_KEY=please-change-me-to-a-random-32-byte-hex-string

# 凭据库：只存「外部源」的凭据（本 registry 自身见上面的 REGISTRY_USERNAME）。
# 凭据文件目录（容器内建议挂载 volume 持久化）
REGISTRY_CREDENTIALS_DIR=/app/data

# 宿主机映射端口（容器内固定 8787）
HOST_PORT=8787

# 镜像名。要推到自己的 registry 就改成带前缀的完整名，
# 例如 192.0.2.10:10001/example/registry-manager:0.2.0
IMAGE=registry-manager:0.2.0

# 构建用的基础镜像。构建机拉不到 Docker Hub 时指向内网副本，
# 注意那份镜像需要与构建机架构一致（内网常见的是 amd64）。
NODE_IMAGE=node:22-alpine
