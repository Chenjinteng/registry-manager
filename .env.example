# Docker Compose 的变量文件。
#   cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交。

# ── 必填 ────────────────────────────────────────────────────────────────────
# 要管理的 registry 地址（必须带 http:// 或 https://）
REGISTRY_URL=http://192.0.2.10:10001

# ── 可选 ────────────────────────────────────────────────────────────────────
# 访问 registry 需要经过的 HTTP 代理；留空表示直连。
# 注意这与「构建机访问 npm 的代理」不是一回事，那个走 --build-arg。
REGISTRY_PROXY=

# 展示名称
REGISTRY_NAME=内网离线镜像源

# 清单缓存时长（秒）
REGISTRY_CACHE_TTL_SECONDS=60

# 设为 false 进入只读模式：隐藏删除入口并拒绝所有删除请求
REGISTRY_ALLOW_DELETE=true

# 设为 false 后服务端拒绝所有 /api/pull/* 写入（GET 列表仍可读历史任务）。
# 单并发 + FIFO 队列；任务仅存内存，重启即丢。
REGISTRY_ALLOW_PULL=true

# 内存里保留的最近任务数（当前 + 排队 + 已完成）；超出后按创建时间最旧剔除
REGISTRY_PULL_QUEUE_SIZE=50

# 宿主机映射端口（容器内固定 8787）
HOST_PORT=8787

# 镜像名。要推到自己的 registry 就改成带前缀的完整名，
# 例如 192.0.2.10:10001/example/registry-manager:0.1.0
IMAGE=registry-manager:0.1.0

# 构建用的基础镜像。构建机拉不到 Docker Hub 时指向内网副本，
# 注意那份镜像需要与构建机架构一致（内网常见的是 amd64）。
NODE_IMAGE=node:22-alpine
