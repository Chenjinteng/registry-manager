# Docker Compose 的变量文件。
#   cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交。

# ── 必填 ────────────────────────────────────────────────────────────────────
# 要管理的 registry 地址（必须带 http:// 或 https://）
REGISTRY_URL=http://192.0.2.10:10001

# ── 可选 ────────────────────────────────────────────────────────────────────
# 访问本 registry 需要经过的 HTTP 代理；留空表示直连。
# 注意这与「构建机访问 npm 的代理」不是一回事，那个走 --build-arg。
# 外部源要用的代理不在这里配，而在页面的「代理管理」里维护。
REGISTRY_PROXY=

# 本 registry 自身的 basic auth（可选）。
# 这是**部署级**凭据：没有它连「镜像列表」都打不开，所以必须在这里配，
# 而不是在页面的凭据管理里 —— 凭据管理只管**外部源**。
# 只暴露布尔给前端，密码不会出现在任何接口响应里。
REGISTRY_USERNAME=
REGISTRY_PASSWORD=

# 展示名称
REGISTRY_NAME=内网离线镜像源

# 清单缓存时长（秒）
REGISTRY_CACHE_TTL_SECONDS=60

# 设为 false 进入只读模式：隐藏删除入口并拒绝所有删除请求
REGISTRY_ALLOW_DELETE=true

# 设为 false 后服务端拒绝所有 /api/pull/* 写入（GET 列表仍可读历史任务）。
# 单并发 + FIFO 队列；任务仅存内存，重启即丢。
REGISTRY_ALLOW_PULL=true

# 内存里保留的最近任务数（当前 + 排队 + 刚完成的几条）。
# **完整历史在 SQLite 里**（`data/registry-manager.db`），所以重启不会丢；
# 这里只决定内存窗口的大小。
REGISTRY_PULL_QUEUE_SIZE=50

# 拉取历史的保留天数。与热度的保留期是**两个独立配置**。
REGISTRY_PULL_HISTORY_RETENTION_DAYS=90

# ── 镜像热度（可选，但配置是两端的）────────────────────────────────────────
# 由 registry 侧主动推送 push/pull 事件（Distribution 的 notifications webhook）来统计。
# ⚠️ 光在这里设密钥**不会**让热度工作：热度靠 registry 主动回调（notifications webhook）拿数据，
#    所以 registry 的 config.yml 里也必须加一段 notifications 指向本服务，并用同一个密钥，
#    改完还要重启 registry 容器（Distribution 没有配置热重载）。
#    步骤见 README 的「镜像热度 § 配置 registry 侧」。页面在没配好时会给出可复制的配置片段。
#
# 这个值必须与 registry 的 notifications.headers.Authorization 里的一致。
# **不设置则拒绝所有事件**（安全默认值）。用 openssl rand -hex 32 生成。
REGISTRY_NOTIFY_TOKEN=

# 设为 false 后不再接收热度事件（已统计的历史仍可查询）
REGISTRY_ALLOW_REGISTRY_EVENTS=true

# 热度数据的保留天数（按天聚合，超出即清理）
REGISTRY_STATS_RETENTION_DAYS=90

# 凭据库密钥（必填；任意随机 32+ 字符字符串）。
# 用于 AES-256-GCM 加密 /app/data/credentials.json。
# **同时丢失密钥和文件 = 凭据永久不可恢复** —— 备份时务必一起带走。
# 用 openssl rand -hex 32 生成：
#   openssl rand -hex 32
REGISTRY_CREDENTIAL_KEY=please-change-me-to-a-random-32-byte-hex-string

# 数据目录：放凭据库（外部源认证）、代理库（外部源代理），以及热度统计的 SQLite 文件。
# 本 registry 自身的认证 / 代理见上面的 REGISTRY_USERNAME、REGISTRY_PROXY。
# 容器内建议挂载 volume 持久化。
REGISTRY_CREDENTIALS_DIR=/app/data

# 宿主机映射端口（容器内固定 8787）
HOST_PORT=8787

# 镜像名。要推到自己的 registry 就改成带前缀的完整名，
# 例如 192.0.2.10:10001/example/registry-manager:0.6.1
IMAGE=registry-manager:0.6.1

# 构建用的基础镜像。构建机拉不到 Docker Hub 时指向内网副本，
# 注意那份镜像需要与构建机架构一致（内网常见的是 amd64）。
# 注意：热度统计用到了 Node 22 自带的 node:sqlite，所以不能低于 node:22。
NODE_IMAGE=node:22-alpine
